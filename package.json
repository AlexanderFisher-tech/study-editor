{
  "name": "antigravity-study-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Minimalist, Notion-style interactive study note editor bundle for Gemini Canvas preview iframes.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "test": "npm run test:unit && npm run build && npm run verify:bundle && npm run test:e2e"
  },
  "dependencies": {
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@preact/preset-vite": "^2.9.3",
    "@types/node": "^22.10.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
